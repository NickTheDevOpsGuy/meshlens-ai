{
  "buildCommand": "pnpm --filter @meshlens/web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/[[...path]].ts": {
      "includeFiles": "apps/web/public/samples/**"
    }
  }
}
