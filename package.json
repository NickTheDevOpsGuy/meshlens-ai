{
  "name": "meshlens-ai",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:web": "pnpm --filter @meshlens/web dev",
    "dev:api": "pnpm --filter @meshlens/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm --filter @meshlens/web run lint:fix",
    "test": "pnpm --filter @meshlens/web test",
    "precheck": "bash scripts/precheck.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20"
  }
}
