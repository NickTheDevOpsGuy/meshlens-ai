# =============================================================================
# Meshlens AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Tetrate Agent Router Service (TARS)
# -----------------------------------------------------------------------------
# Sign in at https://router.tetrate.ai/api-keys to get your API key
# TARS provides OpenAI-compatible AI model routing for incident analysis.
# Required for "Analyze with AI" button on incident details.
TETRATE_API_KEY=

# TARS API base URL (OpenAI-compatible endpoint)
# Default: https://api.router.tetrate.ai - usually no need to change
TARS_API_BASE_URL=https://api.router.tetrate.ai

# AI model for incident analysis (e.g., gpt-4o-mini, claude-4-sonnet-20250514)
# See available models: https://router.tetrate.ai/models
TARS_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
# Port for the API server (default: 3001)
PORT=3001

# -----------------------------------------------------------------------------
# Telemetry / Service Mesh Backends
# -----------------------------------------------------------------------------
# Note: Prometheus, Jaeger, Grafana, and Alertmanager URLs are configured
# in the app Settings (stored in browser localStorage). The API proxies
# requests using URLs passed from the frontend. These .env vars are optional
# if you need to override defaults elsewhere.
#
# Prometheus URL for metrics (e.g., http://prometheus:9090)
# PROMETHEUS_URL=

# Grafana URL for dashboards (e.g., http://grafana:3000)
# GRAFANA_URL=

# Jaeger or Tempo URL for traces (e.g., http://jaeger:16686)
# TRACE_URL=

# Alertmanager URL for firing alerts (e.g., http://alertmanager:9093)
# ALERTMANAGER_URL=

# -----------------------------------------------------------------------------
# Other
# -----------------------------------------------------------------------------
# Node environment: development | production | test
NODE_ENV=development

# VERCEL - Set automatically by Vercel when deployed (do not set manually)
