# =============================================================================
# Meshlens AI - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Tetrate Agent Router Service (TARS)
# -----------------------------------------------------------------------------
# Get your API key from: https://router.tetrate.ai/api-keys
# TARS provides OpenAI-compatible AI model routing for incident analysis.
# Required for "Analyze with AI" button on incident details (API reads from .env).
TETRATE_API_KEY=

# TARS API base URL (OpenAI-compatible endpoint)
# Default: https://api.router.tetrate.ai - usually no need to change
TARS_API_BASE_URL=https://api.router.tetrate.ai

# AI model for incident analysis (e.g., gpt-4o-mini, claude-4-sonnet-20250514)
# See available models: https://router.tetrate.ai/models
TARS_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Telemetry / Service Mesh Backends (optional)
# -----------------------------------------------------------------------------
# Prometheus URL for metrics (e.g., http://prometheus:9090)
PROMETHEUS_URL=

# Grafana URL for dashboards (e.g., http://grafana:3000)
GRAFANA_URL=

# Jaeger or Tempo URL for traces (enables trace drill-down links)
TRACE_URL=

# Alertmanager URL for firing alerts (optional)
# ALERTMANAGER_URL=http://alertmanager:9093

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
# Node environment: development | production | test
NODE_ENV=development
