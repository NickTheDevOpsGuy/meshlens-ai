{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[[...path]].js": {
      "includeFiles": "public/samples/**"
    },
    "api/ai/analyze.js": {
      "includeFiles": "public/samples/**"
    },
    "api/samples/incidents.js": {
      "includeFiles": "public/samples/**"
    },
    "api/samples/version.js": {
      "includeFiles": "public/samples/**"
    },
    "api/health.js": {
      "includeFiles": "public/samples/**"
    }
  }
}
